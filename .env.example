# Template for .env. Copy it, then fill in the values:
#
#     cp .env.example .env
#
# .env is gitignored -- keep real values out of version control. This file is
# committed, so everything here must stay a placeholder.
#
# llm/gemini.py calls load_dotenv() at import, which reads .env into the
# environment. Variables already exported in your shell win over .env.

# --- Vertex AI: required by the Gemini provider ---

# Your Google Cloud project ID. There is no API key; requests authenticate as
# you via Application Default Credentials (see SETUP.md).
GOOGLE_CLOUD_PROJECT=your-project-id

# Region to send requests to, e.g. us-central1.
GOOGLE_CLOUD_LOCATION=us-central1

# Model ID. Required: llm/gemini.py reads this with no fallback, so leaving it
# unset sends model=None and the first request fails.
GEMINI_MODEL=gemini-2.5-flash

# --- Gemini tuning: optional, defaults live in llm/gemini.py ---

# Thinking tokens: 0 disables, -1 lets the model decide, 1..24576 sets a cap.
GEMINI_THINKING_BUDGET=0

# Cap on generated answer tokens. Must be positive. Defaults to 1000.
GEMINI_MAX_OUTPUT_TOKENS=1000

# httpx connection-pool size -- the real client-side concurrency ceiling.
# The default matches httpx's own (100). The benchmark tiers raise it per run;
# leave it at 100 for normal use.
GEMINI_MAX_CONNECTIONS=100

# --- Together: only needed if you use the Together provider ---

# TOGETHER_API_KEY=your-together-api-key
# TOGETHER_MODEL=your-together-model-id
